# Plan-only tests: no AWS credentials or real resources needed.
mock_provider "aws" {}
mock_provider "random" {}

variables {
  environment = "staging"
  tags        = { project = "sapb-training" }
}

run "generates_three_credentials_by_default" {
  command = plan

  assert {
    condition     = length(random_password.db_password) == 1 && length(random_password.admin_token) == 1 && length(random_password.grafana_password) == 1
    error_message = "db, admin token and grafana passwords must be generated by default."
  }

  assert {
    condition     = random_password.admin_token[0].length >= 32
    error_message = "Admin token must be at least 32 characters."
  }

  assert {
    condition     = aws_secretsmanager_secret.this.name == "staging/orderlab-app-secrets"
    error_message = "Secret name must be namespaced by environment."
  }

  assert {
    condition     = aws_secretsmanager_secret.this.tags["project"] == "sapb-training"
    error_message = "Tags must be propagated."
  }
}

run "no_generation_when_disabled" {
  command = plan

  variables {
    generate_random_passwords = false
    custom_secrets            = { EXTERNAL_TOKEN = "from-test" }
  }

  assert {
    condition     = length(random_password.db_password) == 0 && length(random_password.admin_token) == 0
    error_message = "No passwords may be generated when generate_random_passwords is false."
  }
}

run "no_kms_statement_without_custom_key" {
  command = plan

  assert {
    condition     = length(data.aws_iam_policy_document.read_secret.statement) == 1
    error_message = "Without a CMK the reader policy must only contain the secret read statement."
  }
}

run "kms_statement_added_with_custom_key" {
  command = plan

  variables {
    kms_key_id = "arn:aws:kms:us-east-1:111111111111:key/00000000-0000-0000-0000-000000000000"
  }

  assert {
    condition     = length(data.aws_iam_policy_document.read_secret.statement) == 2
    error_message = "A CMK must add a scoped kms:Decrypt statement."
  }
}

run "reader_policy_is_environment_scoped" {
  command = plan

  assert {
    condition     = aws_iam_policy.read_secret.name == "staging-orderlab-app-secrets-read-policy"
    error_message = "Reader policy name must embed the environment."
  }
}
